<Window x:Class="ConstantProxy.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ConstantProxy.App"
        xmlns:loc="clr-namespace:ConstantProxy.App"
        Title="constantproxy" Icon="constantproxy.ico" Width="460" Height="680" MinWidth="440" MinHeight="460"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,2,0,6" />
            <Setter Property="Padding" Value="3" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="90" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="14">
        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="{loc:Loc button.diagnostics}" Command="{Binding DiagnosticsCommand}" MinWidth="0" Padding="8,2" Margin="0,0,6,0" />
                <Button Content="{loc:Loc button.about}" Command="{Binding AboutCommand}" MinWidth="0" Padding="8,2" Margin="0" />
            </StackPanel>
            <TextBlock Text="{Binding VersionText}" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.6" />
        </Grid>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="{loc:Loc button.connect}" Command="{Binding ConnectCommand}" IsDefault="True" />
            <Button Content="{loc:Loc button.disconnect}" Command="{Binding DisconnectCommand}" />
            <Button Content="{loc:Loc button.reconnect}" Command="{Binding ReconnectCommand}" />
            <Button Content="{loc:Loc button.settings}" Command="{Binding SettingsCommand}" />
        </StackPanel>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Content="{loc:Loc label.profile}" Target="{Binding ElementName=ProfileBox}" Padding="0,0,8,0" VerticalAlignment="Center" />
            <ComboBox x:Name="ProfileBox" Grid.Column="1" ItemsSource="{Binding ProfileOptions}" SelectedValuePath="Value" DisplayMemberPath="Label"
                      SelectedValue="{Binding SelectedProfileId}" IsEnabled="{Binding CanEditProfiles}" ToolTip="{loc:Loc tooltip.profileLocked}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                <Button Content="{loc:Loc button.newProfile}" Command="{Binding NewProfileCommand}" ToolTip="{loc:Loc tooltip.newProfile}" MinWidth="0" Padding="10,3" Margin="0,0,4,0" />
                <Button Content="{loc:Loc button.cloneProfile}" Command="{Binding CloneProfileCommand}" ToolTip="{loc:Loc tooltip.cloneProfile}" MinWidth="0" Padding="10,3" Margin="0,0,4,0" />
                <Button Content="{loc:Loc button.deleteProfile}" Command="{Binding DeleteProfileCommand}" ToolTip="{loc:Loc tooltip.deleteProfile}" MinWidth="0" Padding="10,3" Margin="0" />
            </StackPanel>
        </Grid>

        <TabControl x:Name="MainTabs" SelectionChanged="OnTabChanged">
            <TabItem Header="{loc:Loc tab.overview}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" AutomationProperties.Name="{loc:Loc a11y.status}">
                        <TextBlock Text="{Binding StateGlyph}" Foreground="{Binding StateBrush}" FontSize="22" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding SessionDuration}" FontSize="22" FontFamily="Consolas"
                               AutomationProperties.Name="{loc:Loc a11y.duration}" />
                </Grid>

                <TextBlock Text="{Binding StatusDetail}" TextWrapping="Wrap" Margin="0,4,0,0" />

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="{loc:Loc label.socks}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Endpoint}" FontFamily="Consolas" />
                    <TextBlock Text="{loc:Loc label.reconnects}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ReconnectCount}" />
                    <TextBlock Text="{loc:Loc label.latency}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding LatencyText}" />
                </StackPanel>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" AutomationProperties.Name="{loc:Loc a11y.downloadRate}">
                        <TextBlock Text="↓ " FontSize="16" />
                        <TextBlock Text="{Binding DownloadRateText}" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" AutomationProperties.Name="{loc:Loc a11y.uploadRate}">
                        <TextBlock Text="↑ " FontSize="16" />
                        <TextBlock Text="{Binding UploadRateText}" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" AutomationProperties.Name="{loc:Loc a11y.downloaded}">
                        <TextBlock Text="↓ " />
                        <TextBlock Text="{Binding DownloadTotalText}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" AutomationProperties.Name="{loc:Loc a11y.uploaded}">
                        <TextBlock Text="↑ " />
                        <TextBlock Text="{Binding UploadTotalText}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding PeakText}" Margin="0,4,0,0" Opacity="0.8" FontSize="11" />
                <TextBlock Text="{Binding AverageText}" Opacity="0.8" FontSize="11" />

                <local:TrafficGraph Points="{Binding GraphPoints}" WindowSeconds="{Binding GraphWindowSeconds}" EmptyText="{loc:Loc traffic.noData}"
                                    Height="110" Margin="0,8,0,0" AutomationProperties.Name="{loc:Loc a11y.trafficGraph}" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{loc:Loc traffic.graphRange}" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding GraphWindows}" SelectedItem="{Binding GraphWindowSeconds}" MinWidth="70" />
                </StackPanel>

                <Expander Header="{loc:Loc header.details}" Margin="0,6,0,0" Visibility="{Binding HasFailureDetails, Converter={StaticResource BoolToVisibility}}">
                    <TextBox Text="{Binding FailureDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="90"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" />
                </Expander>

                <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="Firebrick" />
            </StackPanel>
        </ScrollViewer>
            </TabItem>
            <TabItem Header="{loc:Loc tab.statistics}" x:Name="StatisticsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8" DataContext="{Binding Statistics}">
                        <TextBlock Text="{Binding SummaryText}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Label Content="{loc:Loc stats.metric}" Target="{Binding ElementName=MetricBox}" Padding="0,0,6,0" VerticalAlignment="Center" />
                            <ComboBox x:Name="MetricBox" ItemsSource="{Binding MetricOptions}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Metric}" MinWidth="110" Margin="0,0,12,0" />
                            <Label Content="{loc:Loc stats.range}" Target="{Binding ElementName=RangeBox}" Padding="0,0,6,0" VerticalAlignment="Center" />
                            <ComboBox x:Name="RangeBox" ItemsSource="{Binding RangeOptions}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Range}" MinWidth="90" />
                        </StackPanel>
                        <local:SeriesGraph Series="{Binding Series}" Unit="{Binding GraphUnit}" EmptyText="{loc:Loc graph.noData}"
                                           Height="170" Margin="0,8,0,0" AutomationProperties.Name="{loc:Loc a11y.historyGraph}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="{loc:Loc stats.refresh}" Command="{Binding RefreshCommand}" />
                            <Button Content="{loc:Loc stats.export}" Command="{Binding ExportCommand}" />
                            <Button Content="{loc:Loc stats.openFolder}" Command="{Binding OpenDataFolderCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{loc:Loc tab.log}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,6,4,2">
                        <Label Content="{loc:Loc label.logFilter}" Target="{Binding ElementName=LogFilterBox}" Padding="0,0,6,0" VerticalAlignment="Center" />
                        <ComboBox x:Name="LogFilterBox" ItemsSource="{Binding LogFilterOptions}" SelectedValuePath="Value" DisplayMemberPath="Label"
                                  SelectedValue="{Binding LogFilter}" MinWidth="150" />
                    </StackPanel>
                    <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" Margin="4"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                             AutomationProperties.Name="{loc:Loc a11y.log}" />
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
