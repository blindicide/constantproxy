<Window x:Class="ConstantProxy.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ConstantProxy.App"
        xmlns:loc="clr-namespace:ConstantProxy.App"
        Title="constantproxy" Icon="constantproxy.ico" Width="460" Height="780" MinWidth="440" MinHeight="460"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,2,0,6" />
            <Setter Property="Padding" Value="3" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="90" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding VersionText}" HorizontalAlignment="Right"
                   Opacity="0.6" Margin="0,8,0,0" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="{loc:Loc button.connect}" Command="{Binding ConnectCommand}" IsDefault="True" />
            <Button Content="{loc:Loc button.disconnect}" Command="{Binding DisconnectCommand}" />
            <Button Content="{loc:Loc button.reconnect}" Command="{Binding ReconnectCommand}" />
        </StackPanel>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Content="{loc:Loc label.profile}" Target="{Binding ElementName=ProfileBox}" Padding="0,0,8,0" VerticalAlignment="Center" />
            <ComboBox x:Name="ProfileBox" Grid.Column="1" ItemsSource="{Binding ProfileOptions}" SelectedValuePath="Value" DisplayMemberPath="Label"
                      SelectedValue="{Binding SelectedProfileId}" IsEnabled="{Binding CanEditProfiles}" ToolTip="{loc:Loc tooltip.profileLocked}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                <Button Content="{loc:Loc button.newProfile}" Command="{Binding NewProfileCommand}" ToolTip="{loc:Loc tooltip.newProfile}" MinWidth="0" Padding="10,3" Margin="0,0,4,0" />
                <Button Content="{loc:Loc button.cloneProfile}" Command="{Binding CloneProfileCommand}" ToolTip="{loc:Loc tooltip.cloneProfile}" MinWidth="0" Padding="10,3" Margin="0,0,4,0" />
                <Button Content="{loc:Loc button.deleteProfile}" Command="{Binding DeleteProfileCommand}" ToolTip="{loc:Loc tooltip.deleteProfile}" MinWidth="0" Padding="10,3" Margin="0" />
            </StackPanel>
        </Grid>

        <TabControl x:Name="MainTabs" SelectionChanged="OnTabChanged">
            <TabItem Header="{loc:Loc tab.overview}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" AutomationProperties.Name="{loc:Loc a11y.status}">
                        <TextBlock Text="{Binding StateGlyph}" Foreground="{Binding StateBrush}" FontSize="22" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding SessionDuration}" FontSize="22" FontFamily="Consolas"
                               AutomationProperties.Name="{loc:Loc a11y.duration}" />
                </Grid>

                <TextBlock Text="{Binding StatusDetail}" TextWrapping="Wrap" Margin="0,4,0,0" />

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="{loc:Loc label.socks}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Endpoint}" FontFamily="Consolas" />
                    <TextBlock Text="{loc:Loc label.reconnects}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ReconnectCount}" />
                    <TextBlock Text="{loc:Loc label.latency}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding LatencyText}" />
                </StackPanel>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" AutomationProperties.Name="{loc:Loc a11y.downloadRate}">
                        <TextBlock Text="↓ " FontSize="16" />
                        <TextBlock Text="{Binding DownloadRateText}" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" AutomationProperties.Name="{loc:Loc a11y.uploadRate}">
                        <TextBlock Text="↑ " FontSize="16" />
                        <TextBlock Text="{Binding UploadRateText}" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" AutomationProperties.Name="{loc:Loc a11y.downloaded}">
                        <TextBlock Text="↓ " />
                        <TextBlock Text="{Binding DownloadTotalText}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" AutomationProperties.Name="{loc:Loc a11y.uploaded}">
                        <TextBlock Text="↑ " />
                        <TextBlock Text="{Binding UploadTotalText}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding PeakText}" Margin="0,4,0,0" Opacity="0.8" FontSize="11" />
                <TextBlock Text="{Binding AverageText}" Opacity="0.8" FontSize="11" />

                <local:TrafficGraph Points="{Binding GraphPoints}" WindowSeconds="{Binding GraphWindowSeconds}" EmptyText="{loc:Loc traffic.noData}"
                                    Height="110" Margin="0,8,0,0" AutomationProperties.Name="{loc:Loc a11y.trafficGraph}" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{loc:Loc traffic.graphRange}" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding GraphWindows}" SelectedItem="{Binding GraphWindowSeconds}" MinWidth="70" />
                </StackPanel>

                <Expander Header="{loc:Loc header.details}" Margin="0,6,0,0" Visibility="{Binding HasFailureDetails, Converter={StaticResource BoolToVisibility}}">
                    <TextBox Text="{Binding FailureDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="90"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" />
                </Expander>

                <Expander x:Name="SettingsExpander" Header="{loc:Loc header.settings}" Margin="0,14,0,0" IsExpanded="True">
                    <StackPanel Margin="0,6,0,0">
                        <Label Content="{loc:Loc label.language}" Target="{Binding ElementName=LanguageBox}" Padding="0" />
                        <ComboBox x:Name="LanguageBox" ItemsSource="{Binding LanguageOptions}" SelectedValuePath="Value" DisplayMemberPath="Label"
                                  SelectedValue="{Binding LanguageSetting}" HorizontalAlignment="Left" MinWidth="220" Margin="0,2,0,8" />
                        <Label Content="{loc:Loc label.profileName}" Target="{Binding ElementName=ProfileNameBox}" Padding="0" />
                        <TextBox x:Name="ProfileNameBox" Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" />
                        <Label Content="{loc:Loc label.sshTarget}" Target="{Binding ElementName=HostBox}" Padding="0" />
                        <TextBox x:Name="HostBox" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <Label Content="{loc:Loc label.socksAddress}" Target="{Binding ElementName=BindBox}" Padding="0" />
                                <TextBox x:Name="BindBox" Text="{Binding BindAddress, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <Label Content="{loc:Loc label.socksPort}" Target="{Binding ElementName=PortBox}" Padding="0" />
                                <TextBox x:Name="PortBox" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <Label Content="{loc:Loc label.sshExecutable}" Target="{Binding ElementName=ExeBox}" Padding="0" />
                        <TextBox x:Name="ExeBox" Text="{Binding SshExecutable, UpdateSourceTrigger=PropertyChanged}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <Label Content="{loc:Loc label.aliveInterval}" Target="{Binding ElementName=AliveBox}" Padding="0" />
                                <TextBox x:Name="AliveBox" Text="{Binding ServerAliveInterval, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <Label Content="{loc:Loc label.aliveCountMax}" Target="{Binding ElementName=CountBox}" Padding="0" />
                                <TextBox x:Name="CountBox" Text="{Binding ServerAliveCountMax, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <Label Content="{loc:Loc label.additionalArgs}" Target="{Binding ElementName=ExtraBox}" Padding="0" />
                        <TextBox x:Name="ExtraBox" Text="{Binding AdditionalArguments, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox Content="{loc:Loc check.ipv4}" IsChecked="{Binding IPv4Only}" Margin="0,2,0,4" />
                        <CheckBox Content="{loc:Loc check.autoReconnect}" IsChecked="{Binding AutoReconnect}" Margin="0,0,0,4" />
                        <CheckBox Content="{loc:Loc check.traffic}" IsChecked="{Binding MeasureTraffic}" Margin="0,0,0,4" />
                        <CheckBox Content="{loc:Loc check.health}" IsChecked="{Binding HealthEnabled}" Margin="0,0,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <Label Content="{loc:Loc label.healthHost}" Target="{Binding ElementName=HealthHostBox}" Padding="0" />
                                <TextBox x:Name="HealthHostBox" Text="{Binding HealthHost, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <Label Content="{loc:Loc label.healthPort}" Target="{Binding ElementName=HealthPortBox}" Padding="0" />
                                <TextBox x:Name="HealthPortBox" Text="{Binding HealthPort, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <CheckBox Content="{loc:Loc check.startWithWindows}" IsChecked="{Binding StartWithWindows}" Margin="0,0,0,4" />
                        <CheckBox Content="{loc:Loc check.connectOnLaunch}" IsChecked="{Binding ConnectOnLaunch}" Margin="0,0,0,4" />
                        <CheckBox Content="{loc:Loc check.startMinimized}" IsChecked="{Binding StartMinimized}" Margin="0,0,0,4" />
                        <CheckBox Content="{loc:Loc check.closeToTray}" IsChecked="{Binding CloseToTray}" Margin="0,0,0,4" />
                        <CheckBox Content="{loc:Loc check.minimizeToTray}" IsChecked="{Binding MinimizeToTray}" Margin="0,0,0,4" />
                        <CheckBox Content="{loc:Loc check.notifyFailure}" IsChecked="{Binding NotifyOnFailure}" Margin="0,0,0,4" />
                        <CheckBox Content="{loc:Loc check.notifyRecovery}" IsChecked="{Binding NotifyOnRecovery}" Margin="0,0,0,4" />
                        <Label Content="{loc:Loc label.outageSeconds}" Target="{Binding ElementName=OutageBox}" Padding="0" />
                        <TextBox x:Name="OutageBox" Text="{Binding MinimumOutageSeconds, UpdateSourceTrigger=PropertyChanged}" Width="90" HorizontalAlignment="Left" />
                        <Button Content="{loc:Loc button.save}" Command="{Binding SaveCommand}" HorizontalAlignment="Left" Margin="0,4,0,6" />
                        <TextBlock Text="{Binding ValidationText}" Foreground="Firebrick" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SettingsNote}" TextWrapping="Wrap" Opacity="0.8" Margin="0,2,0,0" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
            </TabItem>
            <TabItem Header="{loc:Loc tab.statistics}" x:Name="StatisticsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8" DataContext="{Binding Statistics}">
                        <TextBlock Text="{Binding SummaryText}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Label Content="{loc:Loc stats.metric}" Target="{Binding ElementName=MetricBox}" Padding="0,0,6,0" VerticalAlignment="Center" />
                            <ComboBox x:Name="MetricBox" ItemsSource="{Binding MetricOptions}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Metric}" MinWidth="110" Margin="0,0,12,0" />
                            <Label Content="{loc:Loc stats.range}" Target="{Binding ElementName=RangeBox}" Padding="0,0,6,0" VerticalAlignment="Center" />
                            <ComboBox x:Name="RangeBox" ItemsSource="{Binding RangeOptions}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Range}" MinWidth="90" />
                        </StackPanel>
                        <local:SeriesGraph Series="{Binding Series}" Unit="{Binding GraphUnit}" EmptyText="{loc:Loc graph.noData}"
                                           Height="170" Margin="0,8,0,0" AutomationProperties.Name="{loc:Loc a11y.historyGraph}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="{loc:Loc stats.refresh}" Command="{Binding RefreshCommand}" />
                            <Button Content="{loc:Loc stats.export}" Command="{Binding ExportCommand}" />
                            <Button Content="{loc:Loc stats.openFolder}" Command="{Binding OpenDataFolderCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{loc:Loc tab.log}">
                <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" Margin="4"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                         AutomationProperties.Name="{loc:Loc a11y.log}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
