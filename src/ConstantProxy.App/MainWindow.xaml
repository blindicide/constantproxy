<Window x:Class="ConstantProxy.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ConstantProxy.App"
        Title="constantproxy" Width="460" Height="760" MinWidth="400" MinHeight="420"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,2,0,6" />
            <Setter Property="Padding" Value="3" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="90" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding VersionText}" HorizontalAlignment="Right"
                   Opacity="0.6" Margin="0,8,0,0" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="_Connect" Command="{Binding ConnectCommand}" IsDefault="True" />
            <Button Content="_Disconnect" Command="{Binding DisconnectCommand}" />
            <Button Content="_Reconnect now" Command="{Binding ReconnectCommand}" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" AutomationProperties.Name="Connection status">
                        <TextBlock Text="{Binding StateGlyph}" Foreground="{Binding StateBrush}" FontSize="22" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding SessionDuration}" FontSize="22" FontFamily="Consolas"
                               AutomationProperties.Name="Session duration" />
                </Grid>

                <TextBlock Text="{Binding StatusDetail}" TextWrapping="Wrap" Margin="0,4,0,0" />

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="SOCKS " FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Endpoint}" FontFamily="Consolas" />
                    <TextBlock Text="    Reconnects " FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ReconnectCount}" />
                    <TextBlock Text="    Latency " FontWeight="SemiBold" />
                    <TextBlock Text="{Binding LatencyText}" />
                </StackPanel>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" AutomationProperties.Name="Download rate">
                        <TextBlock Text="↓ " FontSize="16" />
                        <TextBlock Text="{Binding DownloadRateText}" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" AutomationProperties.Name="Upload rate">
                        <TextBlock Text="↑ " FontSize="16" />
                        <TextBlock Text="{Binding UploadRateText}" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" AutomationProperties.Name="Downloaded this session">
                        <TextBlock Text="↓ " />
                        <TextBlock Text="{Binding DownloadTotalText}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" AutomationProperties.Name="Uploaded this session">
                        <TextBlock Text="↑ " />
                        <TextBlock Text="{Binding UploadTotalText}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding PeakText}" Margin="0,4,0,0" Opacity="0.8" FontSize="11" />
                <TextBlock Text="{Binding AverageText}" Opacity="0.8" FontSize="11" />

                <local:TrafficGraph Points="{Binding GraphPoints}" WindowSeconds="{Binding GraphWindowSeconds}" EmptyText="No traffic data"
                                    Height="110" Margin="0,8,0,0" AutomationProperties.Name="Traffic graph" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Graph range (seconds): " VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding GraphWindows}" SelectedItem="{Binding GraphWindowSeconds}" MinWidth="70" />
                </StackPanel>

                <Expander Header="Details" Margin="0,6,0,0" Visibility="{Binding HasFailureDetails, Converter={StaticResource BoolToVisibility}}">
                    <TextBox Text="{Binding FailureDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="90"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" />
                </Expander>

                <Expander Header="Connection settings" Margin="0,14,0,0" IsExpanded="True">
                    <StackPanel Margin="0,6,0,0">
                        <Label Content="SSH target (OpenSSH host alias)" Target="{Binding ElementName=HostBox}" Padding="0" />
                        <TextBox x:Name="HostBox" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <Label Content="SOCKS address" Target="{Binding ElementName=BindBox}" Padding="0" />
                                <TextBox x:Name="BindBox" Text="{Binding BindAddress, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <Label Content="SOCKS port" Target="{Binding ElementName=PortBox}" Padding="0" />
                                <TextBox x:Name="PortBox" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <Label Content="SSH executable (empty = automatic detection)" Target="{Binding ElementName=ExeBox}" Padding="0" />
                        <TextBox x:Name="ExeBox" Text="{Binding SshExecutable, UpdateSourceTrigger=PropertyChanged}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <Label Content="ServerAliveInterval" Target="{Binding ElementName=AliveBox}" Padding="0" />
                                <TextBox x:Name="AliveBox" Text="{Binding ServerAliveInterval, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <Label Content="ServerAliveCountMax" Target="{Binding ElementName=CountBox}" Padding="0" />
                                <TextBox x:Name="CountBox" Text="{Binding ServerAliveCountMax, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <Label Content="Additional SSH arguments" Target="{Binding ElementName=ExtraBox}" Padding="0" />
                        <TextBox x:Name="ExtraBox" Text="{Binding AdditionalArguments, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox Content="IPv4 only (-4)" IsChecked="{Binding IPv4Only}" Margin="0,2,0,4" />
                        <CheckBox Content="Reconnect automatically" IsChecked="{Binding AutoReconnect}" Margin="0,0,0,4" />
                        <CheckBox Content="Measure traffic (local byte-counting bridge)" IsChecked="{Binding MeasureTraffic}" Margin="0,0,0,4" />
                        <CheckBox Content="Health checks through the proxy" IsChecked="{Binding HealthEnabled}" Margin="0,0,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <Label Content="Health-check target host" Target="{Binding ElementName=HealthHostBox}" Padding="0" />
                                <TextBox x:Name="HealthHostBox" Text="{Binding HealthHost, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <Label Content="Port" Target="{Binding ElementName=HealthPortBox}" Padding="0" />
                                <TextBox x:Name="HealthPortBox" Text="{Binding HealthPort, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding ValidationText}" Foreground="Firebrick" TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>

                <Expander Header="Log" Margin="0,10,0,0">
                    <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" Height="140" FontFamily="Consolas" FontSize="11"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                             AutomationProperties.Name="Log" />
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
