<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ConstantProxy.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Keep the test SDK entry point when compiling the application entry point for regression coverage. -->
    <StartupObject>AutoGeneratedProgram</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ConstantProxy.Core\ConstantProxy.Core.csproj" />
    <ProjectReference Include="..\..\src\ConstantProxy.Infrastructure\ConstantProxy.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- Exercise the actual entry point without loading Windows WPF on Linux. -->
    <Compile Include="..\..\src\ConstantProxy.App\Program.cs" Link="App\Program.cs" />
  </ItemGroup>

</Project>
